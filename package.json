{
  "name": "operativny-zhurnal-gornogo-dispetchera",
  "version": "1.0.1",
  "description": "Оперативный журнал горного диспетчера — Windows EXE",
  "main": "main.js",
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "22.14.13"
  },
  "build": {
    "appId": "local.mining.dispatcher.journal",
    "productName": "Оперативный журнал горного диспетчера",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "journal_step127.html"
    ],
    "extraResources": [
      {
        "from": "journal_step127.html",
        "to": "journal_step127.html"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Journal-Dispatcher-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Оперативный журнал горного диспетчера",
      "deleteAppDataOnUninstall": false
    }
  }
}
